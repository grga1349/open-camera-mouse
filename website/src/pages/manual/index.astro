---
// Manual contents (WEBSITE.md "Manual"): every page in reading order.
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { url } from "../../lib/url";
import { sortPages } from "../../lib/manual-order";

const pages = sortPages(await getCollection("manual"));
---

<BaseLayout
  title="Manual"
  description="How to install, set up and use Open Camera Mouse on macOS, Windows and Linux."
>
  <h1 class="heading-accent text-3xl font-semibold tracking-tight sm:text-4xl">Manual</h1>
  <p class="mt-4 max-w-prose text-lg text-muted">
    How to install, set up and use Open Camera Mouse.
  </p>
  <ol class="mt-10 grid max-w-prose gap-6">
    {
      pages.map((p) => (
        <li class="border-t border-line pt-4">
          <h2 class="text-xl font-semibold">
            <a href={url(`manual/${p.id}/`)} class="inline-flex min-h-11 items-center">
              {p.data.title}
            </a>
          </h2>
          <p class="mt-1 text-muted">{p.data.description}</p>
        </li>
      ))
    }
  </ol>
</BaseLayout>
