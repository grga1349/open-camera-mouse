---
// Home page, first structure (docs/WEBSITE.md "Homepage"). Only sections with content the
// README and PRODUCT.md support are built; the rest are listed in docs/WEBSITE_ROADMAP.md.
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ShowcasePlaceholder from "../components/ShowcasePlaceholder.astro";
import DownloadEnhancer from "../components/DownloadEnhancer.astro";
import { REPO_URL, url } from "../lib/url";
import { PLATFORMS } from "../lib/platforms";
import { latestRelease } from "../lib/latest-release";
import { getEntry } from "astro:content";
import { pickFaq, rebaseLinks, splitFaq } from "../lib/faq-excerpt";
import { HOME_FAQ } from "../lib/home-faq";

const RELEASES_URL = `${REPO_URL}/releases/latest`;
// Read at build time; null when the API wasn't reachable (cards then link the Releases page).
const release = await latestRelease();

// A few FAQ answers, taken from the manual's FAQ page so they have one source.
const faqPage = await getEntry("manual", "faq");
if (!faqPage?.rendered) throw new Error("manual/faq.md is missing or not rendered");
const faq = pickFaq(splitFaq(faqPage.rendered.html), HOME_FAQ).map((item) => ({
  ...item,
  answer: rebaseLinks(item.answer, url("manual/faq/")),
}));

// Engineering notes, each from README.md / docs/PRODUCT.md / docs/ARCHITECTURE.md /
// docs/TESTING.md; nothing here may say more than those do.
const engineering = [
  {
    title: "Independent Rust implementation",
    body: "Written from scratch in Rust, with no OpenCV. Behaviour starts from the classic Camera Mouse 2018 and improves on it where it was weak; new behaviour arrives as an option, off by default.",
  },
  {
    title: "Tracking and stability",
    body: "The spot you pick is followed with pyramidal Lucas–Kanade optical flow and checked against how it looked a moment earlier, so a hand passing in front of the camera ends tracking instead of dragging the pointer. Smoothing and a small steady zone keep the pointer still while your head is.",
  },
  {
    title: "Private by design",
    body: "Everything runs on your computer: no camera image leaves it. No accounts, no cloud, no telemetry. Settings are a plain text file in your user folder.",
  },
  {
    title: "Tested without a camera",
    body: "The tracker and the pointer maths are tested on synthetic, seeded video with known ground truth, and every change runs the tests on macOS, Windows and Linux. Windows and Linux builds have not been tried on a real device yet.",
  },
];

const DOCS_URL = `${REPO_URL}/blob/main/docs`;

// Origin story sources (docs/WEBSITE.md "Origin story"): every historical sentence in
// #why-it-exists is backed by one of these, checked 2026-11-21.
const originSources = [
  {
    label: "M. Betke, J. Gips, P. Fleming, “The Camera Mouse: visual tracking of body features to provide computer access for people with severe disabilities”, IEEE Transactions on Neural Systems and Rehabilitation Engineering 10(1), 1–10, March 2002",
    href: "https://doi.org/10.1109/TNSRE.2002.1021581",
  },
  {
    label: "Boston College News, “BC ‘Camera Mouse’ Assistive Technology Tops 3 Million Downloads”, 25 August 2016",
    href: "https://www.bc.edu/content/bc-web/bcnews/science-tech-and-health/technology/camera-mouse-boston-college.html",
  },
  {
    label: "Boston College News, “In Memoriam: Boston College Computer Scientist James Gips”, 12 June 2018",
    href: "https://www.bc.edu/content/bc-web/bcnews/campus-community/faculty/in-memoriam--james-gips.html",
  },
];

const steps = [
  {
    title: "Pick a spot",
    body: "Press Start and click a spot on your face in the camera preview. The tip of the nose works well.",
  },
  {
    title: "Move your head",
    body: "The pointer follows. Moving the physical mouse takes over at once; keep it still for 4 seconds and the camera has the pointer again.",
  },
  {
    title: "Click by holding still",
    body: "Turn on dwell click in Options, and holding the pointer still over something clicks it.",
  },
];
---

<BaseLayout
  fullBleed
  description="Control the mouse pointer with your head, using an ordinary webcam. Free and open source for macOS, Windows and Linux."
>
  <Hero />

  <Section id="showcase" title="See it working" divider={false}>
    <ShowcasePlaceholder />
  </Section>

  <Section id="why-it-exists" title="Why it exists">
    <div class="max-w-prose space-y-4">
      <p>
        Camera Mouse was created at Boston College by James Gips and Margrit Betke, growing out
        of the college's EagleEyes project. A video camera follows a feature of the body, such as
        the tip of the nose, and its movement moves the mouse pointer, so people who can't
        reliably use their hands can still use a computer.
      </p>
      <p>
        It became a free download in June 2007. By 2016 it had been downloaded more
        than three million times, by people with cerebral palsy, ALS, spinal muscular atrophy,
        brain injuries and other conditions. James Gips died in 2018.
      </p>
      <p>
        Open Camera Mouse continues the idea as a new, independent program: written from scratch,
        open source, and for macOS, Windows and Linux. It starts from how Camera Mouse 2018
        behaves and improves on it. It is not affiliated with or endorsed by Boston College or
        the original authors.
      </p>
    </div>
    <h3 class="mt-10 text-sm tracking-wide uppercase">Sources</h3>
    <ol class="mt-2 max-w-prose list-decimal space-y-2 pl-6 text-sm text-muted">
      {
        originSources.map((s) => (
          <li>
            <a href={s.href} class="text-text">{s.label}</a>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section id="how-it-works" title="How it works">
    <ol class="grid gap-8 md:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="border-t-4 border-text pt-4">
            <p class="text-sm text-muted" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </p>
            <h3 class="mt-2 text-xl font-semibold">{step.title}</h3>
            <p class="mt-2">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8">
      <a href={url("manual/getting-started/")} class="inline-flex min-h-11 items-center font-semibold">
        Read the manual<span aria-hidden="true">&nbsp;→</span>
      </a>
    </p>
  </Section>

  <Section
    id="engineering"
    title="Engineering"
    lead="How Open Camera Mouse is built, and what that means for you."
  >
    <ul class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        engineering.map((item) => (
          <li class="border-t-4 border-text pt-4">
            <h3 class="text-xl font-semibold">{item.title}</h3>
            <p class="mt-2">{item.body}</p>
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <a href={`${DOCS_URL}/ARCHITECTURE.md`} class="inline-flex min-h-11 items-center font-semibold">
        Architecture on GitHub<span aria-hidden="true">&nbsp;→</span>
      </a>
    </p>
  </Section>

  <Section
    id="download"
    title="Download"
    lead={release
      ? `Version ${release.version}. Pick the file for your system. Installation steps and permissions are in the manual.`
      : "Pick the file for your system from the latest release. Installation steps and permissions are in the manual."}
  >
    <p data-detect="unsupported" hidden class="mb-8 max-w-prose border-l-4 border-text pl-4">
      Open Camera Mouse runs on macOS, Windows and Linux computers, not on this device. Download
      it on the computer you want to use it with.
    </p>
    <ul class="grid gap-6 md:grid-cols-3">
      {
        PLATFORMS.map((p) => {
          const files = release?.downloads[p.id] ?? [];
          return (
            <li class="flex flex-col rounded-frame border border-line bg-surface p-6">
              <p data-detect={p.id} hidden class="mb-2 text-sm tracking-wide uppercase">
                Your system
              </p>
              <h3 class="text-xl font-semibold">{p.name}</h3>
              <p class="mt-1 text-muted">{p.requirement}</p>
              {files.length === 0 && (
                <p class="mt-4 text-sm">{p.assets.map((a) => a.label).join(" or ")}</p>
              )}
              <ul class="mt-4 list-disc pl-5 text-sm text-muted">
                {p.notes.map((n) => (
                  <li>{n}</li>
                ))}
              </ul>
              {files.length > 0 && (
                <ul class="mt-6 flex flex-col gap-3">
                  {files.map((f) => (
                    <li>
                      <a
                        href={f.url}
                        class="inline-flex min-h-11 w-full items-center justify-center rounded-widget border-2 border-text px-4 text-center font-semibold no-underline"
                      >
                        <span class="sr-only">Download {p.name} </span>
                        {f.label}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
              <p class="mt-auto pt-6">
                <a href={url(`manual/installation/#${p.installAnchor}`)} class="inline-flex min-h-11 items-center">
                  {p.name} install steps
                </a>
              </p>
            </li>
          );
        })
      }
    </ul>
    {
      release ? (
        <p class="mt-8">
          <a href={release.pageUrl} class="inline-flex min-h-11 items-center">
            Release notes, all files and checksums for version {release.version}
          </a>
        </p>
      ) : (
        <p class="mt-8">
          <a
            href={RELEASES_URL}
            class="inline-flex min-h-12 items-center rounded-widget bg-yellow px-6 text-lg font-semibold text-on-yellow no-underline"
          >
            Go to the latest release
          </a>
        </p>
      )
    }
  </Section>

  <Section id="faq" title="Questions">
    <ul class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {
        faq.map((item) => (
          <li class="border-t border-line pt-6">
            <h3 class="text-xl font-semibold" set:html={item.question} />
            <div class="manual-prose mt-3" set:html={item.answer} />
          </li>
        ))
      }
    </ul>
    <p class="mt-10">
      <a href={url("manual/faq/")} class="inline-flex min-h-11 items-center font-semibold">
        All questions<span aria-hidden="true">&nbsp;→</span>
      </a>
    </p>
  </Section>

  <Section id="open-source" title="Open source">
    <p class="max-w-prose">
      Open Camera Mouse is free software under the MIT licence. The code, the issue tracker and
      the developer documentation are on GitHub; how to use the app is in the manual.
    </p>
    <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
      <div>
        <h3 class="text-sm tracking-wide uppercase">Get involved</h3>
        <ul class="mt-2">
          <li><a href={REPO_URL} class="inline-flex min-h-11 items-center">Source code</a></li>
          <li>
            <a href={`${REPO_URL}/issues`} class="inline-flex min-h-11 items-center">Report a problem or suggest a change</a>
          </li>
          <li>
            <a href={`${REPO_URL}#develop`} class="inline-flex min-h-11 items-center">Build it yourself</a>
          </li>
          <li>
            <a href={`${REPO_URL}/blob/main/AGENTS.md`} class="inline-flex min-h-11 items-center">How work is done in the repository</a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm tracking-wide uppercase">Documentation</h3>
        <ul class="mt-2">
          <li><a href={url("manual/")} class="inline-flex min-h-11 items-center">User manual</a></li>
          <li>
            <a href={`${DOCS_URL}/PRODUCT.md`} class="inline-flex min-h-11 items-center">Product and defaults</a>
          </li>
          <li>
            <a href={`${DOCS_URL}/TESTING.md`} class="inline-flex min-h-11 items-center">Testing</a>
          </li>
          <li>
            <a href={`${REPO_URL}/tree/main/docs/architecture/decisions`} class="inline-flex min-h-11 items-center">Design decisions</a>
          </li>
        </ul>
      </div>
    </div>
  </Section>

  <DownloadEnhancer />
</BaseLayout>
