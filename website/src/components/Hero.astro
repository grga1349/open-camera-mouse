---
// Yellow angular hero (WEBSITE_DESIGN.md "Header and hero"), continuing the yellow header. Copy is a
// first draft, not approved. The primary action goes to the on-page download section; with
// JavaScript, DownloadEnhancer.astro points it at the visitor's file instead and swaps the
// note under it (WEBSITE_DESIGN.md "Downloads").
import { url } from "../lib/url";
import { PLATFORMS } from "../lib/platforms";
import { latestRelease } from "../lib/latest-release";

const release = await latestRelease();
// Platforms the hero can download directly: the preferred (first) file of each.
const direct = release
  ? PLATFORMS.flatMap((p) => {
      const file = release.downloads[p.id][0];
      return file ? [{ platform: p, url: file.url }] : [];
    })
  : [];
const links = Object.fromEntries(direct.map((d) => [d.platform.id, { url: d.url, name: d.platform.name }]));
---

<section aria-labelledby="hero-title" class="on-brand angular-bottom relative overflow-hidden">
  <div
    class="relative z-10 mx-auto max-w-5xl px-4 pt-8 pb-[calc(var(--cut)+3rem)] sm:px-6 md:pt-16"
  >
    <p class="animate-rise-in text-sm tracking-wide uppercase">
      Free and open source · MIT licence
    </p>
    <h1
      id="hero-title"
      class="animate-rise-in mt-4 max-w-[12ch] text-5xl leading-none font-black tracking-tight uppercase [animation-delay:80ms] sm:text-7xl"
    >
      Your head. Your mouse.
    </h1>
    <p class="animate-rise-in mt-6 max-w-[36rem] text-lg [animation-delay:160ms] sm:text-xl">
      Open Camera Mouse moves the pointer as you move your head, using an ordinary webcam.
      Everything runs on your computer; no camera image leaves it.
    </p>
    <ul class="animate-rise-in mt-8 flex flex-wrap gap-4 [animation-delay:240ms]">
      <li>
        <a
          id="hero-download"
          href={url("#download")}
          data-downloads={JSON.stringify(links)}
          class="inline-flex min-h-12 items-center rounded-widget bg-on-brand px-6 text-lg font-semibold text-brand no-underline transition-transform hover:-translate-y-0.5"
        >
          Download
        </a>
      </li>
      <li>
        <a
          href={url("#showcase")}
          class="inline-flex min-h-12 items-center rounded-widget border-2 border-on-brand px-6 text-lg font-semibold no-underline transition-transform hover:-translate-y-0.5"
        >
          See it working
        </a>
      </li>
    </ul>
    <div class="animate-rise-in mt-4 text-sm [animation-delay:240ms]">
      {release && <p data-detect-default>Version {release.version} for macOS, Windows and Linux.</p>}
      {
        direct.map(({ platform }) => (
          <p data-detect={platform.id} hidden>
            Version {release!.version}, for {platform.requirement}. <a href={url("#download")}>Other systems</a>
          </p>
        ))
      }
      <p data-detect="unsupported" hidden>
        Open Camera Mouse runs on macOS, Windows and Linux computers, not on this device.
      </p>
    </div>
  </div>
</section>
