---
import { url, REPO_URL } from "../lib/url";
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href={url("/")} class="flex min-h-11 items-center gap-3 font-semibold no-underline">
      <img src={url("icon-128.png")} alt="" width="32" height="32" class="rounded-widget" />
      Open Camera Mouse
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-4">
        <li><a href={REPO_URL} class="inline-flex min-h-11 items-center">Source code</a></li>
      </ul>
    </nav>
  </div>
</header>
