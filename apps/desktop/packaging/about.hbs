<!DOCTYPE html>
<!-- cargo-about template (ADR-0021). Output: THIRD_PARTY_LICENSES.html, shipped next to LICENSE. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Open Camera Mouse — third-party licences</title>
<style>
  body { font: 15px/1.5 system-ui, sans-serif; max-width: 52rem; margin: 2rem auto; padding: 0 1rem; color: #111; background: #fff; }
  h1 { font-size: 1.5rem; }
  h2 { font-size: 1.1rem; margin-top: 2.5rem; border-top: 1px solid #ccc; padding-top: 1rem; }
  ul.crates { padding-left: 1.2rem; }
  pre { white-space: pre-wrap; font-size: 13px; background: #f4f4f4; padding: 1rem; }
  @media (prefers-color-scheme: dark) {
    body { color: #eee; background: #111; }
    pre { background: #1d1d1d; }
    h2 { border-color: #444; }
  }
</style>
</head>
<body>
<h1>Third-party licences</h1>
<p>Open Camera Mouse is built with the open-source software listed below. Each licence's full
text follows the list of crates it covers.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<h2 id="{{id}}">{{name}}</h2>
<p>Used by:</p>
<ul class="crates">
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
